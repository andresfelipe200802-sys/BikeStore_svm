# Servidor HTTP
PORT=3000
NODE_ENV=development

# Bases de datos PostgreSQL
DATABASE_URL=postgres://postgres:CAMBIAR_PASSWORD@localhost:5432/bikestore_dev
TEST_DATABASE_URL=postgres://postgres:CAMBIAR_PASSWORD@localhost:5432/bikestore_test
DB_POOL_MAX=10
DB_SSL=false

# Autenticación y seguridad
JWT_SECRET=CAMBIAR_POR_SECRETO_LARGO_ALEATORIO_MINIMO_32_CHARS
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=10

# CORS y enlaces frontend
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Correo (json para desarrollo local y pruebas; smtp para Mailtrap Sandbox en demo)
SMTP_TRANSPORT=json
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=CAMBIAR_MAILTRAP_USER
SMTP_PASS=CAMBIAR_MAILTRAP_PASS
SMTP_FROM=BikeStore <no-responder@bikestore.local>

# Job de expiración de reservas (0 deshabilita el barrido periódico)
RESERVA_SWEEP_INTERVAL_MS=60000

# Rate limiting en autenticación
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10

# Semilla idempotente de administrador inicial (npm run db:seed)
SEED_ADMIN_EMAIL=admin@bikestore.local
SEED_ADMIN_PASSWORD=AdminBikeStore2026!
SEED_ADMIN_DOC_TIPO=CC
SEED_ADMIN_DOC_NUM=1000000001
SEED_ADMIN_NOMBRE=Administrador
SEED_ADMIN_APELLIDO=Principal
SEED_ADMIN_TELEFONO=3000000000
